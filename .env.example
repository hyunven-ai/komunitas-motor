# Supabase Public Configuration (Exposed to Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Server-Only Secret Key (NEVER expose to browser client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Initial Super Admin Setup (Used by seeding/admin bootstrap script)
INITIAL_ADMIN_EMAIL=admin@brotherhood.local
INITIAL_ADMIN_PASSWORD=change-me-in-production

# ==============================================================================
# Cloudflare R2 Object Storage (S3-Compatible)
# ==============================================================================
STORAGE_PROVIDER=r2
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=brotherhood-portal
CLOUDFLARE_R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
NEXT_PUBLIC_ADMIN_WHATSAPP=6281299887711
